# Copy to backend/.env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://calling_agent:calling_agent@localhost:5432/calling_agent

# --- Security ---
# Fernet key(s) that encrypt provider credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, old keys after it (comma-separated), run
#   python -m app.cli rotate-keys
# then remove the old keys. In production, inject this from a KMS / secret manager.
# If empty, a development key is generated into backend/.encryption_key (gitignored).
ENCRYPTION_KEY=
# Set true when serving over HTTPS.
COOKIE_SECURE=false
ALLOW_SIGNUP=true

# --- Web ---
FRONTEND_ORIGIN=http://localhost:3000
# Public HTTPS URL that Retell can reach (e.g. `ngrok http 8000`). Required for Custom Brain mode
# (Retell connects to our conversation WebSocket) and for webhooks. Without it, Managed mode still
# works and call status is refreshed by polling the Retell API.
PUBLIC_BASE_URL=

# --- Platform defaults (each user can override these in Settings -> API & Providers) ---
RETELL_API_KEY=
RETELL_FROM_NUMBER=

# --- Conversation engine (Custom Brain, playbook generator, simulator) ---
# openai | local_slm
CONVERSATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For CONVERSATION_PROVIDER=local_slm: any OpenAI-compatible server (vLLM, Ollama, llama.cpp...).
LOCAL_SLM_BASE_URL=http://localhost:11434/v1
LOCAL_SLM_MODEL=
LOCAL_SLM_API_KEY=

# --- Speech / voice pipeline (Twilio + Custom Brain mode) ---
# Provider endpoints. Defaults are the official APIs; override only for regional endpoints or mocks.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# TWILIO_BASE_URL=https://api.twilio.com
# ElevenLabs model used for phone audio (low latency, multilingual incl. Hindi).
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
STT_CONNECT_TIMEOUT_S=10
STT_REQUEST_TIMEOUT_S=30
# Run Alembic migrations on startup (set false if you migrate in a deploy step).
AUTO_MIGRATE=true

# --- Calling safeguards ---
# Optional comma-separated allow-list of destination numbers (E.164). Strongly recommended for the POC.
ALLOWED_DESTINATION_NUMBERS=
# Region used to parse numbers typed without a country code (ISO 3166 alpha-2), e.g. IN or US.
DEFAULT_PHONE_REGION=IN
# Reject webhooks without a valid x-retell-signature. Only disable for local debugging.
VERIFY_WEBHOOK_SIGNATURE=true
